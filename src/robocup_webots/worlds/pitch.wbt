#VRML_SIM R2025a utf8

EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/robots/softbank/nao/protos/Nao.proto"

WorldInfo {
  basicTimeStep 20
}
Viewpoint {
  orientation -0.3087 0.3087 0.8997 1.6763
  position 0 -9 7
}
Background {
  skyColor [ 0.7 0.8 0.9 ]
}
DirectionalLight {
  direction -0.3 0.2 -1
  intensity 1.5
}

Solid {
  name "pitch"
  children [
    Pose {
      translation 0 0 -0.005
      children [
        Shape {
          appearance PBRAppearance { baseColor 0.1 0.55 0.1 roughness 1 metalness 0 }
          geometry DEF CARPET Box { size 11 8 0.01 }
        }
      ]
    }
    Pose {
      translation 0 3 0.001
      children [
        Shape {
          appearance DEF LINE PBRAppearance { baseColor 1 1 1 roughness 1 metalness 0 }
          geometry Box { size 9.05 0.05 0.002 }
        }
      ]
    }
    Pose {
      translation 0 -3 0.001
      children [ Shape { appearance USE LINE geometry Box { size 9.05 0.05 0.002 } } ]
    }
    Pose {
      translation -4.5 0 0.001
      children [ Shape { appearance USE LINE geometry Box { size 0.05 6.05 0.002 } } ]
    }
    Pose {
      translation 4.5 0 0.001
      children [ Shape { appearance USE LINE geometry Box { size 0.05 6.05 0.002 } } ]
    }
    Pose {
      translation 0 0 0.001
      children [ Shape { appearance USE LINE geometry Box { size 0.05 6.05 0.002 } } ]
    }
  ]
  boundingObject Pose { translation 0 0 -0.005 children [ USE CARPET ] }
}

# ------------------------------------------------------------------
# RED TEAM (left half, facing +x): 1 goalkeeper, 2 defenders, 1 striker
# controller "<extern>" = controlled from ROS 2
# ------------------------------------------------------------------
Nao {
  translation -4.2 0 0.334
  name "red_goalkeeper"
  version "V5 (red)"
  degreeOfFreedom 21
  controller "<extern>"
}
Nao {
  translation -3 1 0.334
  name "red_defender_1"
  version "V5 (red)"
  degreeOfFreedom 21
  controller "<extern>"
}
Nao {
  translation -3 -1 0.334
  name "red_defender_2"
  version "V5 (red)"
  degreeOfFreedom 21
  controller "<extern>"
}
Nao {
  translation -1 0 0.334
  name "red_striker"
  version "V5 (red)"
  degreeOfFreedom 21
  controller "<extern>"
}

# ------------------------------------------------------------------
# BLUE TEAM (right half, facing -x = rotated 180 degrees): same roles, mirrored
# ------------------------------------------------------------------
Nao {
  translation 4.2 0 0.334
  rotation 0 0 1 3.14159
  name "blue_goalkeeper"
  version "V5 (blue)"
  degreeOfFreedom 21
  controller "<extern>"
}
Nao {
  translation 3 -1 0.334
  rotation 0 0 1 3.14159
  name "blue_defender_1"
  version "V5 (blue)"
  degreeOfFreedom 21
  controller "<extern>"
}
Nao {
  translation 3 1 0.334
  rotation 0 0 1 3.14159
  name "blue_defender_2"
  version "V5 (blue)"
  degreeOfFreedom 21
  controller "<extern>"
}
Nao {
  translation 1 0 0.334
  rotation 0 0 1 3.14159
  name "blue_striker"
  version "V5 (blue)"
  degreeOfFreedom 21
  controller "<extern>"
}

Solid {
  translation 0 0 0.07
  name "ball"
  children [
    Shape {
      appearance PBRAppearance { baseColor 1 0.45 0 roughness 0.6 metalness 0 }
      geometry DEF BALL Sphere { radius 0.07 subdivision 3 }
    }
  ]
  boundingObject USE BALL
  physics Physics {
    density -1
    mass 0.2
    damping Damping { linear 0.17 angular 0.33 }
  }
}